{
  "name": "@worktif/utils",
  "version": "0.3.1",
  "description": "TypeScript utilities library providing dependency injection, logging, exception handling, and Zod validation tools with AWS Lambda integration",
  "author": "Raman Marozau, raman@worktif.com",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/bundle.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./.docs && yarn run docs && rm -rf ./dist && yarn run build:config && NODE_ENV=production node bin/esbuild/dist/esbuild.config.js && yarn run types && tsc-alias",
    "build:config": "esbuild --bundle --platform=node bin/esbuild/esbuild.config.ts --outfile=bin/esbuild/dist/esbuild.config.js --external:esbuild",
    "test": "npx jest --selectProjects unit --runInBand --colors --verbose --testTimeout=20000",
    "test:coverage": "npx jest --selectProjects unit --coverage --runInBand --colors --testTimeout=20000",
    "pretest:e2e": "node test/e2e/guard/ensure-fresh-dist.js",
    "test:e2e": "npx jest --selectProjects e2e --runInBand --colors --verbose --testTimeout=20000",
    "docs:md": "typedoc --options ./docs/docs.config/typedoc.md.json",
    "docs:html": "typedoc --options ./docs/docs.config/typedoc.html.json",
    "docs": "yarn run docs:md && yarn run docs:html",
    "docs:app:router:gen": "mkdir -p docs/app/src && ts-node docs/app/scripts/router.gen.ts",
    "types": "tsc --emitDeclarationOnly",
    "prepare": "yarn run build",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.23.0",
    "dotenv": "^17.2.3",
    "inversify": "^7.5.4",
    "lodash": "^4.17.21",
    "picocolors": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.0.12",
    "esbuild": "^0.27.1",
    "fast-check": "^4.3.0",
    "http-status-codes": "^2.3.0",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typedoc": "^0.28.7",
    "typedoc-plugin-markdown": "^4.7.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "javascript",
    "utils",
    "worktif"
  ],
  "contributors": [
    {
      "email": "raman@worktif.com",
      "name": "Raman Marozau",
      "url": "https://worktif.com"
    }
  ],
  "maintainers": [
    {
      "email": "raman@worktif.com",
      "name": "Raman Marozau",
      "url": "https://worktif.com"
    }
  ],
  "homepage": "https://github.com/worktif/npm-utils#readme",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worktif/npm-utils"
  },
  "bugs": {
    "url": "https://github.com/worktif/npm-utils/issues"
  },
  "directories": {
    "doc": "docs"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
