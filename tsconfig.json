{
  "compilerOptions": {
    "incremental": true,
    "target": "ES2017",
    "module": "commonjs",
    "lib": [
      "es6",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "reflect-metadata",
      "node",
      "jest"
    ],
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "dist",
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "strict": true,
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "downlevelIteration": true,
    "isolatedModules": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "paths": {
      "@core/bundle/*": [
        "src/bundle/*"
      ],
      "@core/config/*": [
        "src/config/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/test-harness/**/*.ts",
    "test/test-harness/**/*.tsx",
  ],
  "buildOptions": {
    "outDir": "./dist"
  },
  "exclude": [
    "node_modules/**/*.ts",
    "dist/**/*.js"
  ]
}
